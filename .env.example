# Порт, на котором приложение доступно на хосте
APP_PORT=8080

# Заглушка двухфакторной аутентификации: код, который принимается при входе
OTP_STUB_CODE=000000

# Через сколько коэффициент долговой нагрузки считается устаревшим
TRUST_REFRESH_INTERVAL=12h

# Сколько API ждёт ответа воркера
WORKER_TIMEOUT=8s

# PostgreSQL (учётные данные демонстрационные)
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
POSTGRES_DB=credit
