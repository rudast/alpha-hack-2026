# Коллекция запросов (REST Client для VS Code / HTTP-файлы JetBrains).
# Работают /healthz, вход, /me/bootstrap и создание/отправка заявки. Остальное — черновой контракт из openapi.yaml.
# Тестовые учётные записи и пароль описаны в README. Код 2FA-заглушки: 000000.

@host = http://localhost:8080

### Проверка работоспособности
GET {{host}}/healthz

### Вход клиента, шаг 1: пароль (в login можно указать и почту: client2@example.test)
# @name clientLogin
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "role": "client",
  "login": "+79990000002",
  "password": "demo-password"
}

### Вход клиента, шаг 2: код 2FA
# @name clientVerify
POST {{host}}/api/v1/auth/verify
Content-Type: application/json

{
  "challenge_id": "{{clientLogin.response.body.challenge_id}}",
  "code": "000000"
}

### Обновить показатели долговой нагрузки после входа
POST {{host}}/api/v1/me/bootstrap
Authorization: Bearer {{clientVerify.response.body.token}}

### Вход сотрудника, шаг 1: пароль
# @name employeeLogin
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "role": "employee",
  "login": "underwriter@example.test",
  "password": "demo-password"
}

### Вход сотрудника, шаг 2: код 2FA
# @name employeeVerify
POST {{host}}/api/v1/auth/verify
Content-Type: application/json

{
  "challenge_id": "{{employeeLogin.response.body.challenge_id}}",
  "code": "000000"
}

### Каталог продуктов
GET {{host}}/api/v1/products

### Расчёт платежа
POST {{host}}/api/v1/calculator
Content-Type: application/json

{ "product_id": "working_capital", "amount": 1000000, "term_months": 12 }

### Кредиты клиента
GET {{host}}/api/v1/loans
Authorization: Bearer {{token}}

### Создать черновик заявки
# @name applicationCreate
POST {{host}}/api/v1/applications
Authorization: Bearer {{clientVerify.response.body.token}}
Content-Type: application/json

{
  "product_id": "working_capital",
  "amount": 1000000,
  "term_months": 12,
  "purpose": "Пополнение оборотных средств",
  "form": {"applicant": {"position": "Директор", "has_collateral": false}}
}

### Демо-файл паспорта (содержимое служит только для проверки потока)
POST {{host}}/api/v1/applications/{{applicationCreate.response.body.id}}/documents
Authorization: Bearer {{clientVerify.response.body.token}}
Content-Type: application/json

{"kind":"passport","filename":"passport.txt","media_type":"text/plain","content_base64":"ZGVtby1wYXNzcG9ydA=="}

### Демо-согласие на БКИ (подпись здесь не проверяется)
POST {{host}}/api/v1/applications/{{applicationCreate.response.body.id}}/documents
Authorization: Bearer {{clientVerify.response.body.token}}
Content-Type: application/json

{"kind":"bki_consent","filename":"consent.txt","media_type":"text/plain","content_base64":"ZGVtby1jb25zZW50"}

### Структурированная финансовая отчётность
POST {{host}}/api/v1/applications/{{applicationCreate.response.body.id}}/documents
Authorization: Bearer {{clientVerify.response.body.token}}
Content-Type: application/json

{"kind":"financial_statements","filename":"report.json","media_type":"application/json","content_base64":"eyJwZXJpb2QiOiIyMDI1IiwicmV2ZW51ZSI6MTAwMDAwMCwibmV0X3Byb2ZpdCI6MjAwMDAwLCJlcXVpdHkiOjUwMDAwMCwibGlhYmlsaXRpZXMiOjMwMDAwMH0="}

### Отправить заявку
POST {{host}}/api/v1/applications/{{applicationCreate.response.body.id}}/submit
Authorization: Bearer {{clientVerify.response.body.token}}

### Получить статусы и результаты заданий
GET {{host}}/api/v1/applications/{{applicationCreate.response.body.id}}
Authorization: Bearer {{clientVerify.response.body.token}}

### Очередь заявок андеррайтера
GET {{host}}/api/v1/employee/applications?status=MANUAL_REVIEW
Authorization: Bearer {{token}}

### Решение по заявке
POST {{host}}/api/v1/employee/applications/{{applicationId}}/decision
Authorization: Bearer {{token}}
Content-Type: application/json

{ "outcome": "COUNTER_OFFER", "amount": 700000, "rate": 18.5, "comment": "Снижена сумма" }
