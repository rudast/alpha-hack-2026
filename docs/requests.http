# Коллекция запросов (REST Client для VS Code / HTTP-файлы JetBrains).
# Работают все запросы, кроме расчёта платежа и методов сотрудника (черновой контракт из openapi.yaml).
# Тестовые учётные записи и пароль описаны в README. Код 2FA-заглушки: 000000.

@host = http://localhost:8080

### Проверка работоспособности
GET {{host}}/healthz

### Вход клиента, шаг 1: пароль (в login можно указать и почту: client2@example.test)
# @name clientLogin
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "role": "client",
  "login": "+79990000002",
  "password": "demo-password"
}

### Вход клиента, шаг 2: код 2FA
# @name clientVerify
POST {{host}}/api/v1/auth/verify
Content-Type: application/json

{
  "challenge_id": "{{clientLogin.response.body.challenge_id}}",
  "code": "000000"
}

### Профиль клиента и компании
GET {{host}}/api/v1/me
Authorization: Bearer {{clientVerify.response.body.token}}

### Кредиты компании, график платежей, кредиты в других банках
GET {{host}}/api/v1/loans
Authorization: Bearer {{clientVerify.response.body.token}}

### Обновить показатели долговой нагрузки после входа
POST {{host}}/api/v1/me/bootstrap
Authorization: Bearer {{clientVerify.response.body.token}}

### Создать черновик заявки (первое сохранение формы)
# Idempotency-Key обязателен для POST и PATCH по заявкам. Здесь {{$guid}} — новый ключ на каждую отправку;
# чтобы проверить повтор, подставьте один и тот же ключ вручную в два запроса.
# @name createApplication
POST {{host}}/api/v1/applications
Authorization: Bearer {{clientVerify.response.body.token}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{ "product_id": "express" }

### Сохранить изменения черновика (version — из ответа; form заменяется целиком)
PATCH {{host}}/api/v1/applications/{{createApplication.response.body.id}}
Authorization: Bearer {{clientVerify.response.body.token}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "version": {{createApplication.response.body.version}},
  "amount": 500000,
  "term_months": 6,
  "purpose": "Пополнение оборотных средств",
  "form": {
    "applicant": { "position": "Директор", "has_collateral": false },
    "consents": { "bki_request": true, "personal_data": true }
  }
}

### Предварительное предложение для баннера
# @name offer
GET {{host}}/api/v1/me/offer
Authorization: Bearer {{clientVerify.response.body.token}}

### Создать черновик по предложению (кнопка «Оформить»): продукт, сумма и срок берутся из предложения
POST {{host}}/api/v1/applications
Authorization: Bearer {{clientVerify.response.body.token}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{ "offer_id": "{{offer.response.body.offer.id}}" }

### Загрузить документ к черновику (PDF, JPG или PNG до 10 МБ; путь к файлу — свой)
POST {{host}}/api/v1/applications/{{createApplication.response.body.id}}/documents
Authorization: Bearer {{clientVerify.response.body.token}}
Idempotency-Key: {{$guid}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="kind"

passport
--boundary
Content-Disposition: form-data; name="file"; filename="passport.pdf"
Content-Type: application/pdf

< ./passport.pdf
--boundary--

### Список заявок компании
GET {{host}}/api/v1/applications
Authorization: Bearer {{clientVerify.response.body.token}}

### Просмотр заявки (только владелец, чужая даёт 404)
GET {{host}}/api/v1/applications/{{createApplication.response.body.id}}
Authorization: Bearer {{clientVerify.response.body.token}}

### Отправить заявку (черновик становится SUBMITTED; в форме нужно согласие consents.bki_request = true)
POST {{host}}/api/v1/applications/{{createApplication.response.body.id}}/submit
Authorization: Bearer {{clientVerify.response.body.token}}
Idempotency-Key: {{$guid}}

### Принять одобрение или встречное предложение (заявка в APPROVED или COUNTER_OFFER): кредит становится ACTIVE
POST {{host}}/api/v1/applications/{{createApplication.response.body.id}}/accept
Authorization: Bearer {{clientVerify.response.body.token}}
Idempotency-Key: {{$guid}}

### Отказаться от встречного предложения (COUNTER_OFFER → DRAFT)
POST {{host}}/api/v1/applications/{{createApplication.response.body.id}}/decline
Authorization: Bearer {{clientVerify.response.body.token}}
Idempotency-Key: {{$guid}}

### Вход сотрудника, шаг 1: пароль
# @name employeeLogin
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "role": "employee",
  "login": "underwriter@example.test",
  "password": "demo-password"
}

### Вход сотрудника, шаг 2: код 2FA
# @name employeeVerify
POST {{host}}/api/v1/auth/verify
Content-Type: application/json

{
  "challenge_id": "{{employeeLogin.response.body.challenge_id}}",
  "code": "000000"
}

### Каталог продуктов (без входа)
GET {{host}}/api/v1/products

### Расчёт платежа
POST {{host}}/api/v1/calculator
Content-Type: application/json

{ "product_id": "working-capital", "amount": 1000000, "term_months": 12 }

### Очередь заявок андеррайтера
GET {{host}}/api/v1/employee/applications
Authorization: Bearer {{employeeVerify.response.body.token}}

### Взять заявку в работу
POST {{host}}/api/v1/employee/applications/{{applicationId}}/take
Idempotency-Key: {{$guid}}
Authorization: Bearer {{employeeVerify.response.body.token}}

### Решение по заявке
POST {{host}}/api/v1/employee/applications/{{applicationId}}/decision
Authorization: Bearer {{employeeVerify.response.body.token}}
Content-Type: application/json

{ "action": "counter_offer", "product_id": "ooo_loan", "amount": 700000, "term_months": 24, "rate": 18.5, "reason": "Снижена сумма" }
